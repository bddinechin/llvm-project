// RUN: mlir-opt %s -split-input-file -convert-to-lvx | FileCheck %s

// Elementwise rows of docs/VectorCoverage.md (Phase 1) that lower today.
// Generated by the probe in scratch; see README.md for the row format.

// -----

// ROW: arith.addi | i8x16
// CHECK-LABEL: @arith_addi_i8x16
// CHECK: lvx.addbx
func.func @arith_addi_i8x16(%a: memref<64xi8>, %b: memref<64xi8>, %c: memref<64xi8>, %s: i8) {
  %i = arith.constant 0 : index
  %x = vector.load %a[%i] : memref<64xi8>, vector<16xi8>
  %y = vector.load %b[%i] : memref<64xi8>, vector<16xi8>
  // ROW-OP
  %z = arith.addi %x, %y : vector<16xi8>
  vector.store %z, %c[%i] : memref<64xi8>, vector<16xi8>
  return
}

// -----

