#ifndef LVX_BASE
#define LVX_BASE

include "mlir/IR/AttrTypeBase.td"
include "mlir/IR/EnumAttr.td"
include "mlir/IR/OpBase.td"

// Generated by lvx-mds' MDS/BE/MLIR from the machine description; delivered
// here by `make -C BE/MLIR install`. Do not edit them in place.
include "mlir/Dialect/LVX/IR/LVXRegisters.td"
include "mlir/Dialect/LVX/IR/LVXModifiers.td"

def LVX_Dialect : Dialect {
  let name = "lvx";
  let cppNamespace = "::mlir::lvx";
  let description = [{
    The LVX dialect represents LVX_v1 machine instructions in SSA form,
    before register allocation and instruction scheduling. Operations
    correspond one-to-one to real assembly instructions (as described by
    the LVX_v1 machine description in the sibling `lvx-mds` repo, under
    `lvx-mds/lvx-refs/`),
    using real mnemonics and modifier suffixes. Every live machine value is
    represented as an `!lvx.reg`: an unallocated virtual register until a
    later register-allocation pass assigns it a physical register (encoded
    in the type itself, following the "physical registers as types"
    approach). LVX has a single unified 64-bit general-purpose register
    file (R0-R63) used for both scalar integer and floating-point values;
    instruction width (32- vs. 64-bit) is a property of the mnemonic, not
    of the register.
  }];

  let useDefaultTypePrinterParser = 1;
  let hasConstantMaterializer = 1;
}

//===----------------------------------------------------------------------===//
// Physical register enum (R0-R63, plus the RA control register), used to
// parameterize the LVX_RegType once a value has been allocated.
//===----------------------------------------------------------------------===//

// Now generated: see LVXRegisters.td, included above.

//===----------------------------------------------------------------------===//
// LVX register type: `!lvx.reg` (unallocated) or `!lvx.reg<r5>` (allocated).
//===----------------------------------------------------------------------===//

class LVX_Type<string name, string typeMnemonic, list<Trait> traits = []>
    : TypeDef<LVX_Dialect, name, traits> {
  let mnemonic = typeMnemonic;
}

def LVX_RegType : LVX_Type<"Register", "reg"> {
  let summary = "an LVX general-purpose register value";
  let description = [{
    The type of every live machine value in the LVX dialect. `!lvx.reg`
    (no parameter) denotes a virtual register, not yet assigned to
    hardware; `!lvx.reg<r5>` denotes a value pinned to (or, after register
    allocation, assigned to) physical register `$r5`.
  }];
  let parameters = (ins "std::optional<Register>":$reg);
  let hasCustomAssemblyFormat = 1;
  let builders = [
    TypeBuilder<(ins), [{
      return $_get($_ctxt, std::optional<Register>{});
    }]>
  ];
  let extraClassDeclaration = [{
    /// Whether this register has been pinned/allocated to a physical
    /// register, as opposed to being a not-yet-allocated virtual register.
    bool isAllocated() const { return getReg().has_value(); }
  }];
}

//===----------------------------------------------------------------------===//
// The tuple types: `!lvx.pair` / `!lvx.pair<r0r1>` and `!lvx.quad` /
// `!lvx.quad<r0r1r2r3>` -- lvx-mds/docs/MLIR-backend-design.md §8.3.
//
// A pair is a register, not a convention over two registers: the ISA's
// pairedReg file has 32 members, r0r1 .. r62r63, and there is no r1r2, so
// the class *is* the aligned set and a pinned pair cannot be misaligned. The
// three files are disjoint register sets with disjoint names, and a value
// cannot move between them without an instruction -- which is why these are
// types of their own rather than a width parameter on `!lvx.reg`: the
// verifier must refuse `lvx.abddp %a, %b` with `%a : !lvx.reg`.
//
// The parameter enums are valued by the ISA's `address`, the number of the
// first component, so pair `p` holds singles `p` and `p+1` and quad `q`
// holds pairs `q` and `q+2` -- the arithmetic the register allocator
// relies on to treat all three as blocks of one unit space.
//===----------------------------------------------------------------------===//

def LVX_PairType : LVX_Type<"Pair", "pair"> {
  let summary = "an LVX aligned register-pair value (128 bits)";
  let description = [{
    The type of a 128-bit value held in an aligned pair of general-purpose
    registers. `!lvx.pair` (no parameter) is a virtual pair, not yet
    allocated; `!lvx.pair<r2r3>` is pinned to (or, after register allocation,
    assigned to) the physical pair `$r2r3`.
  }];
  let parameters = (ins "std::optional<PairRegister>":$reg);
  let hasCustomAssemblyFormat = 1;
  let builders = [
    TypeBuilder<(ins), [{
      return $_get($_ctxt, std::optional<PairRegister>{});
    }]>
  ];
  let extraClassDeclaration = [{
    bool isAllocated() const { return getReg().has_value(); }
  }];
}

def LVX_QuadType : LVX_Type<"Quad", "quad"> {
  let summary = "an LVX aligned register-quadruple value (256 bits)";
  let description = [{
    The type of a 256-bit value held in an aligned quadruple of
    general-purpose registers. `!lvx.quad` (no parameter) is a virtual quad,
    not yet allocated; `!lvx.quad<r4r5r6r7>` is pinned to (or, after register
    allocation, assigned to) the physical quadruple `$r4r5r6r7`.
  }];
  let parameters = (ins "std::optional<QuadRegister>":$reg);
  let hasCustomAssemblyFormat = 1;
  let builders = [
    TypeBuilder<(ins), [{
      return $_get($_ctxt, std::optional<QuadRegister>{});
    }]>
  ];
  let extraClassDeclaration = [{
    bool isAllocated() const { return getReg().has_value(); }
  }];
}

// A value of any of the three register types. What the control dialects
// carry across a loop or a branch edge, and what the copy and lane pseudos
// take: a loop-carried accumulator is a pair as readily as a single.
def LVX_AnyRegType : AnyTypeOf<[LVX_RegType, LVX_PairType, LVX_QuadType]>;

// A composite op's source (Builtin@split, LVXComposites.inc): the quad whose
// two pairs the two parts take, or one pair that every part reads whole -- a
// broadcast operand, which reaches a composite this way because the ISA has
// no quad splat.
def LVX_PairOrQuadType : AnyTypeOf<[LVX_PairType, LVX_QuadType]>;

//===----------------------------------------------------------------------===//
// The cycle an op issues in, relative to the start of its block:
// `-lvx-schedule`'s result, read by `-lvx-emit-asm`, which closes a bundle
// where the cycle changes and prints `;;  # (end cycle N)` -- the same fact
// lvx-gcc's scheduler records and its printer shows (lvx-mlir/docs/
// Bundling.md). A bundle is the ops of one cycle; a cycle with no op is a
// stall the hardware takes on its own. Declared on every op of the four
// dialects rather than left a discardable annotation, so that it is typed,
// verified and part of the op's own state; absent means "not scheduled",
// and the emitter then prints the op as a bundle of its own.
//===----------------------------------------------------------------------===//

def LVX_CycleAttr : OptionalAttr<I64Attr>;

//===----------------------------------------------------------------------===//
// Modifier enums are generated: see LVXModifiers.td, included above. The two
// facts that used to live here as comments now live in the generator -- that
// floatmode has no `cs` member (design document O4) and that `.R5` is a
// reserved encoding -- and are derived from the description rather than
// restated.
//===----------------------------------------------------------------------===//

//===----------------------------------------------------------------------===//
// The op base class. Here rather than in LVXOps.td because the generated
// LVXInstrOps.td needs it too, and that file includes only this one.
//===----------------------------------------------------------------------===//

class LVX_Op<string mnemonic, list<Trait> traits = []> :
    Op<LVX_Dialect, mnemonic, traits>;

#endif // LVX_BASE
